{
  "expo": {
    "name": "HomeWise",
    "slug": "HomeWiseMobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "homewisemobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.homewise.mobile"
    },
    "android": {
      "package": "com.homewise.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#07131b",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Permitir que o HomeWise acesse a câmera para escanear o QR Code da sua Central."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permitir que o HomeWise acesse uma foto para o seu perfil.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#07131b",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
